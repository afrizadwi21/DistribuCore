# ==============================================================================
# DistribuCore Local Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_PORT=8080

# PostgreSQL Configuration
POSTGRES_USER=distribucore_user
POSTGRES_PASSWORD=distribucore_secret
POSTGRES_DB=distribucore_db
POSTGRES_PORT=5433
POSTGRES_HOST=localhost
DATABASE_URL=postgres://distribucore_user:distribucore_secret@localhost:5433/distribucore_db?sslmode=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET=super-secret-distribucore-jwt-key-change-in-production
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
