{
  "openapi": "3.0.3",
  "info": {
    "title": "DistribuCore REST API - Dokumentasi Resmi",
    "description": "Dokumentasi interaktif DistribuCore: Sistem Manajemen Distribusi B2B Multi-Tenant untuk distributor bahan bangunan, grosir, dan logistik regional.\n\n### Panduan Penggunaan:\n1. Gunakan endpoint **Registrasi Perusahaan & Admin** untuk membuat akun baru.\n2. Lakukan **Login** untuk mendapatkan token JWT (`access_token`).\n3. Klik tombol **Authorize** di atas dan masukkan token JWT Anda untuk menguji endpoint yang terproteksi.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Server Pengembangan Lokal"
    }
  ],
  "tags": [
    { "name": "01. Autentikasi & Akun", "description": "Registrasi tenant baru, login pengguna, dan profil akun JWT" },
    { "name": "02. Satuan Barang (UOM)", "description": "Master data satuan ukuran barang dan unit dasar" },
    { "name": "03. Master Produk (Catalog)", "description": "Katalog produk SKU, spesifikasi, dan batas safety stock" },
    { "name": "04. Pelanggan (Customers)", "description": "Direktori pelanggan toko/kontraktor dengan limit plafon kredit" },
    { "name": "05. Pemasok (Suppliers)", "description": "Direktori vendor dan pabrik rekanan distributor" },
    { "name": "06. Gudang (Warehouses)", "description": "Manajemen fasilitas fisik gudang penyimpanan barang" },
    { "name": "07. Lokasi Rak (Bins)", "description": "Tata letak rak, lorong, dan bin penyimpanan di dalam gudang" },
    { "name": "08. Inventaris & Saldo Stok", "description": "Penyesuaian stok opname dan saldo fisik on-hand per rak" },
    { "name": "09. Sistem & Server", "description": "Pengecekan status operasional dan kesehatan server" },
    { "name": "10. Pesanan Pembelian (Purchase Orders)", "description": "Pembuatan PO ke pemasok, rincian biaya, dan siklus approval order" },
    { "name": "11. Penerimaan Barang (Goods Receipt Notes)", "description": "Penerimaan fisik barang masuk dari supplier ke rak gudang dan update stok otomatis" }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Masukkan token JWT yang didapat dari endpoint login (format: Bearer <token>)"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["09. Sistem & Server"],
        "summary": "Cek Kesehatan Server",
        "description": "Memeriksa apakah server Go Fiber aktif dan dapat melayani permintaan.",
        "responses": {
          "200": { "description": "Server berjalan normal dan sehat" }
        }
      }
    },
    "/api/v1/auth/register-tenant": {
      "post": {
        "tags": ["01. Autentikasi & Akun"],
        "summary": "Daftar Perusahaan (Tenant) Baru & Buat Akun Admin",
        "description": "Membuat entitas perusahaan baru, membuat role ADMIN, dan akun administrator utama dalam satu transaksi database.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tenant_code", "tenant_name", "email", "password"],
                "properties": {
                  "tenant_code": { "type": "string", "example": "DIST-001", "description": "Kode unik perusahaan" },
                  "tenant_name": { "type": "string", "example": "PT Distribusi Bangunan Sejahtera", "description": "Nama resmi perusahaan" },
                  "email": { "type": "string", "example": "admin@distribusibangunan.com", "description": "Email login administrator" },
                  "password": { "type": "string", "example": "PasswordKuat123!", "description": "Password minimal 8 karakter" },
                  "full_name": { "type": "string", "example": "Budi Santoso", "description": "Nama lengkap pengguna" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Perusahaan dan akun admin berhasil didaftarkan" }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["01. Autentikasi & Akun"],
        "summary": "Login Pengguna & Dapatkan Token JWT",
        "description": "Memvalidasi email dan password dalam batas tenant yang sesuai. Mengembalikan access token dan refresh token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tenant_code", "email", "password"],
                "properties": {
                  "tenant_code": { "type": "string", "example": "DIST-001", "description": "Kode perusahaan" },
                  "email": { "type": "string", "example": "admin@distribusibangunan.com", "description": "Email akun terdaftar" },
                  "password": { "type": "string", "example": "PasswordKuat123!", "description": "Password akun" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login berhasil, mengembalikan token akses" }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": ["01. Autentikasi & Akun"],
        "summary": "Lihat Profil Pengguna yang Sedang Login",
        "description": "Mengambil data akun, tenant ID, dan role pengguna dari token JWT yang aktif.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Data profil pengguna yang terotentikasi" }
        }
      }
    },
    "/api/v1/catalog/uom": {
      "get": {
        "tags": ["02. Satuan Barang (UOM)"],
        "summary": "Daftar Satuan Ukuran Barang (UOM)",
        "description": "Mengambil semua daftar satuan barang yang terdaftar untuk perusahaan Anda.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Daftar satuan ukuran barang" }
        }
      },
      "post": {
        "tags": ["02. Satuan Barang (UOM)"],
        "summary": "Tambah Satuan Ukuran Baru",
        "description": "Mendaftarkan satuan baru seperti PCS, DUS, SAK, atau PALET.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code", "name"],
                "properties": {
                  "code": { "type": "string", "example": "SAK", "description": "Kode singkatan satuan" },
                  "name": { "type": "string", "example": "Sak 50 Kilogram", "description": "Nama lengkap satuan" },
                  "is_base_unit": { "type": "boolean", "example": true, "description": "Apakah ini satuan dasar terkecil" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Satuan berhasil dibuat" }
        }
      }
    },
    "/api/v1/catalog/products": {
      "get": {
        "tags": ["03. Master Produk (Catalog)"],
        "summary": "Daftar Master Produk dengan Paginasi",
        "description": "Mengambil katalog barang dagangan dengan pagination dan join otomatis ke satuan dasar.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "description": "Nomor halaman (default: 1)", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "description": "Jumlah data per halaman (default: 20)", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "Daftar produk berhasil diambil" }
        }
      },
      "post": {
        "tags": ["03. Master Produk (Catalog)"],
        "summary": "Buat Master Produk SKU Baru",
        "description": "Mendaftarkan barang baru lengkap dengan ambang batas stok aman dan titik pemesanan ulang.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sku", "name", "base_uom_id"],
                "properties": {
                  "sku": { "type": "string", "example": "SMN-TR-50KG", "description": "Kode SKU unik barang" },
                  "name": { "type": "string", "example": "Semen Tiga Roda 50kg", "description": "Nama dagang barang" },
                  "description": { "type": "string", "example": "Semen Portland tipe 1 untuk plester dan cor", "description": "Deskripsi barang" },
                  "base_uom_id": { "type": "string", "format": "uuid", "example": "a0000000-0000-0000-0000-000000000001", "description": "ID satuan dasar dari tabel UOM" },
                  "safety_stock_quantity": { "type": "number", "example": 100, "description": "Batas stok minimum peringatan" },
                  "reorder_point_quantity": { "type": "number", "example": 250, "description": "Batas stok untuk order ulang ke pabrik" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Produk berhasil ditambahkan" }
        }
      }
    },
    "/api/v1/catalog/products/{id}": {
      "get": {
        "tags": ["03. Master Produk (Catalog)"],
        "summary": "Detail Satu Produk Berdasarkan ID",
        "description": "Mengambil rincian lengkap spesifikasi produk.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "UUID produk", "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Rincian data produk" }
        }
      }
    },
    "/api/v1/partners/customers": {
      "get": {
        "tags": ["04. Pelanggan (Customers)"],
        "summary": "Daftar Pelanggan (Customer) & Limit Kredit",
        "description": "Mengambil seluruh pelanggan lengkap dengan informasi batas plafon kredit dan tempo pembayaran.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Daftar pelanggan aktif" }
        }
      },
      "post": {
        "tags": ["04. Pelanggan (Customers)"],
        "summary": "Daftarkan Pelanggan Baru",
        "description": "Menambahkan toko/kontraktor baru dengan limit kredit piutang (dalam satuan sen/rupiah).",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code", "company_name"],
                "properties": {
                  "code": { "type": "string", "example": "CUST-001", "description": "Kode pelanggan" },
                  "company_name": { "type": "string", "example": "Toko Bangunan Sumber Makmur", "description": "Nama toko/kontraktor" },
                  "contact_person": { "type": "string", "example": "Haji Slamet", "description": "Nama penanggung jawab" },
                  "email": { "type": "string", "example": "slamet@sumbermakmur.com", "description": "Email kontak" },
                  "phone": { "type": "string", "example": "081234567890", "description": "Nomor telepon/WhatsApp" },
                  "credit_limit_cents": { "type": "integer", "example": 5000000000, "description": "Plafon kredit (contoh 50 juta)" },
                  "payment_terms_days": { "type": "integer", "example": 30, "description": "Termin tempo pembayaran (hari)" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Pelanggan berhasil didaftarkan" }
        }
      }
    },
    "/api/v1/partners/suppliers": {
      "get": {
        "tags": ["05. Pemasok (Suppliers)"],
        "summary": "Daftar Pemasok (Supplier)",
        "description": "Mengambil seluruh daftar vendor/pabrik rekanan distributor.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Daftar supplier aktif" }
        }
      },
      "post": {
        "tags": ["05. Pemasok (Suppliers)"],
        "summary": "Daftarkan Supplier Baru",
        "description": "Mendaftarkan vendor/pabrik rekanan baru.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code", "company_name"],
                "properties": {
                  "code": { "type": "string", "example": "SUPP-001", "description": "Kode supplier" },
                  "company_name": { "type": "string", "example": "PT Semen Gresik Distribusi", "description": "Nama perusahaan supplier" },
                  "contact_person": { "type": "string", "example": "Agus Hendrawan", "description": "Kontak sales pabrik" },
                  "email": { "type": "string", "example": "sales@semengresik.com", "description": "Email supplier" },
                  "phone": { "type": "string", "example": "0215551234", "description": "Nomor telepon kantor" },
                  "payment_terms_days": { "type": "integer", "example": 45, "description": "Termin tempo pembayaran dari supplier" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Supplier berhasil didaftarkan" }
        }
      }
    },
    "/api/v1/inventory/warehouses": {
      "get": {
        "tags": ["06. Gudang (Warehouses)"],
        "summary": "Daftar Fasilitas Gudang",
        "description": "Mengambil seluruh gudang penyimpanan yang terdaftar untuk perusahaan.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Daftar gudang aktif" }
        }
      },
      "post": {
        "tags": ["06. Gudang (Warehouses)"],
        "summary": "Tambah Gudang Baru",
        "description": "Mendaftarkan lokasi gudang baru (misal: Gudang Pusat, Gudang Transit).",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code", "name"],
                "properties": {
                  "code": { "type": "string", "example": "WH-PST", "description": "Kode gudang" },
                  "name": { "type": "string", "example": "Gudang Pusat Cikarang", "description": "Nama gudang" },
                  "address_line": { "type": "string", "example": "Kawasan Industri MM2100 Blok C-4" },
                  "city": { "type": "string", "example": "Bekasi" },
                  "state_province": { "type": "string", "example": "Jawa Barat" },
                  "postal_code": { "type": "string", "example": "17530" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Gudang berhasil didaftarkan" }
        }
      }
    },
    "/api/v1/inventory/warehouses/{warehouseId}/bins": {
      "get": {
        "tags": ["07. Lokasi Rak (Bins)"],
        "summary": "Daftar Lokasi Rak (Bin) di Gudang",
        "description": "Mengambil seluruh daftar rak, lorong, dan bin di gudang tertentu.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "warehouseId", "in": "path", "required": true, "description": "UUID Gudang", "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Daftar bin di gudang" }
        }
      },
      "post": {
        "tags": ["07. Lokasi Rak (Bins)"],
        "summary": "Tambah Rak/Bin Penyimpanan",
        "description": "Menambahkan nomor rak/bin baru (misal: Lorong A1, Rak 2, Bin 4).",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "warehouseId", "in": "path", "required": true, "description": "UUID Gudang", "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code"],
                "properties": {
                  "code": { "type": "string", "example": "A1-R02-B04", "description": "Kode bin unik dalam gudang" },
                  "zone": { "type": "string", "example": "Zona Berat / Semen", "description": "Zona atau area gudang" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Bin rak berhasil didaftarkan" }
        }
      }
    },
    "/api/v1/inventory/adjustments": {
      "post": {
        "tags": ["08. Inventaris & Saldo Stok"],
        "summary": "Penyesuaian Stok (Stock Adjustment / Opname)",
        "description": "Menyesuaikan jumlah stok fisik (tambah/kurang) dan otomatis mencatat mutasi ke buku besar inventaris (inventory transactions).",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["warehouse_id", "bin_id", "product_id", "quantity_delta"],
                "properties": {
                  "warehouse_id": { "type": "string", "format": "uuid", "description": "ID Gudang" },
                  "bin_id": { "type": "string", "format": "uuid", "description": "ID Rak/Bin" },
                  "product_id": { "type": "string", "format": "uuid", "description": "ID Produk SKU" },
                  "quantity_delta": { "type": "number", "example": 50, "description": "Jumlah perubahan stok (+ untuk masuk, - untuk keluar/rusak)" },
                  "transaction_type": { "type": "string", "example": "ADJUSTMENT_CYCLE_COUNT", "description": "Jenis mutasi stok" },
                  "notes": { "type": "string", "example": "Stok awal hasil opname fisik", "description": "Catatan penyesuaian" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Stok fisik berhasil disesuaikan dan dicatat di buku besar" }
        }
      }
    },
    "/api/v1/inventory/warehouses/{warehouseId}/balances": {
      "get": {
        "tags": ["08. Inventaris & Saldo Stok"],
        "summary": "Lihat Saldo Stok Fisik per Gudang & Rak",
        "description": "Mengambil saldo stok barang saat ini di setiap rak pada gudang yang dipilih.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "warehouseId", "in": "path", "required": true, "description": "UUID Gudang", "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Daftar saldo stok di gudang" }
        }
      }
    },
    "/api/v1/purchasing/orders": {
      "get": {
        "tags": ["10. Pesanan Pembelian (Purchase Orders)"],
        "summary": "Daftar Pesanan Pembelian (PO)",
        "description": "Mengambil seluruh PO yang terbit dengan filter supplier dan status order.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "supplier_id", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Daftar pesanan pembelian" } }
      },
      "post": {
        "tags": ["10. Pesanan Pembelian (Purchase Orders)"],
        "summary": "Buat Purchase Order Baru",
        "description": "Menerbitkan order pembelian baru ke supplier dengan item dan estimasi biaya.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["po_number", "supplier_id", "destination_warehouse_id", "items"],
                "properties": {
                  "po_number": { "type": "string", "example": "PO-2026-001" },
                  "supplier_id": { "type": "string", "format": "uuid" },
                  "destination_warehouse_id": { "type": "string", "format": "uuid" },
                  "issued_date": { "type": "string", "example": "2026-11-10" },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["product_id", "uom_id", "ordered_quantity", "unit_cost_cents"],
                      "properties": {
                        "product_id": { "type": "string", "format": "uuid" },
                        "uom_id": { "type": "string", "format": "uuid" },
                        "ordered_quantity": { "type": "number", "example": 500 },
                        "unit_cost_cents": { "type": "integer", "example": 6500000 }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Purchase order berhasil diterbitkan" } }
      }
    },
    "/api/v1/purchasing/orders/{id}": {
      "get": {
        "tags": ["10. Pesanan Pembelian (Purchase Orders)"],
        "summary": "Detail Purchase Order & Sisa Qty Belum Diterima",
        "description": "Melihat rincian PO dan perbandingan kuantitas yang dipesan vs sudah diterima.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Rincian purchase order" } }
      }
    },
    "/api/v1/purchasing/orders/{id}/status": {
      "patch": {
        "tags": ["10. Pesanan Pembelian (Purchase Orders)"],
        "summary": "Ubah Status Purchase Order (Approval)",
        "description": "Menyetujui PO (APPROVED) agar barang dapat diterima fisik di gudang.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": { "status": { "type": "string", "example": "APPROVED" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Status PO berhasil diperbarui" } }
      }
    }
  }
}
